{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{src,knowledgebase,config,samples}/**",
      "excludeFiles": "{.venv,tests,data,reports}/**"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }]
}
