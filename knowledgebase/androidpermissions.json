      "data_or_functionality": "Network communication / data exfiltration channel",
      "legitimate_uses": ["Content loading", "Sync", "Ads/analytics", "Maps", "Streaming"],
      "justifying_purposes": ["navigation", "messaging", "social", "news", "shopping", "streaming", "weather", "banking"],
      "excess_conditions": ["App has no network-backed feature", "Combined with sensitive data permissions without stated purpose"],
      "alternatives": ["Bundle content offline"],
      "doc_urls": ["https://developer.android.com/reference/android/Manifest.permission#INTERNET"],
      "notes": "Not a dangerous permission, but it amplifies the impact of every other permission by enabling transmission."
    },
