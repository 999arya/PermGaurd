{
  "version": "1.0.0",
  "last_verified": "2026-10-15",
  "notes": "Category profiles express EXPECTED permissions for an app category — they are allow-lists for necessity checking, not hard security rules. Expected != automatically justified; unexpected != automatically malicious. verdict logic: expected->JUSTIFIED, plausible (adjacent)->PLAUSIBLE, unexpected->UNEXPECTED, no purpose->UNDETERMINED.",
  "keywords": {
    "calculator": ["calculat", "math", "arithmetic", "converter"],
    "navigation": ["nav", "map", "gps", "route", "direction", "driving", "transit"],
    "voice_recorder": ["record", "voice", "audio", "memo", "dictaphone"],
    "camera": ["camera", "photo", "snap", "shoot"],
    "photo_editor": ["edit", "photo editor", "filter", "retouch", "collage"],
    "flashlight": ["flash", "torch", "lamp", "light"],
    "messaging": ["messag", "chat", "sms", "messenger", "talk"],
    "music": ["music", "player", "audio player", "podcast", "stream"],
    "weather": ["weather", "forecast"],
    "social": ["social", "feed", "post", "profile"],
    "banking": ["bank", "pay", "wallet", "finance"],
    "fitness": ["fit", "health", "workout", "run", "step", "gym"],
    "file_manager": ["file", "explorer", "manager", "storage"],
    "email": ["mail", "email", "inbox"],
    "productivity": ["note", "task", "to-do", "organizer", "office"],
    "alarm": ["alarm", "clock", "timer", "stopwatch"],
    "dialer": ["dialer", "phone", "call"],
    "games": ["game", "play"],
    "news": ["news", "headline"],
