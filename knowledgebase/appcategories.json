  "categories": {
    "calculator": {
      "label": "Calculator / Converter",
      "expected_permissions": [
        "android.permission.VIBRATE"
      ],
      "optional_permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "suggested_features": ["Arithmetic", "Unit conversion", "History"],
      "rationale": "A calculator performs local computation; VIBRATE provides haptic button feedback. It needs no sensitive resource access.",
      "common_excess_risks": ["Contacts", "Location", "Storage", "SMS"]
    },
    "navigation": {
      "label": "Navigation / Maps",
      "expected_permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "optional_permissions": ["android.permission.ACCESS_BACKGROUND_LOCATION", "android.permission.BLUETOOTH", "android.permission.BLUETOOTH_CONNECT"],
      "suggested_features": ["Turn-by-turn directions", "Traffic", "Offline maps"],
      "rationale": "Location is the core input of navigation; background access is justified only for guidance while the screen is off.",
      "common_excess_risks": ["Contacts", "SMS", "Microphone"]
    },
    "voice_recorder": {
      "label": "Voice Recorder",
      "expected_permissions": [
