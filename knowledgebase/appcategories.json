      "optional_permissions": ["android.permission.WAKE_LOCK", "android.permission.READ_MEDIA_AUDIO", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.READ_EXTERNAL_STORAGE"],
      "suggested_features": ["Record", "Playback", "Export"],
      "rationale": "Microphone is the defining capability; storage is needed only to persist recordings.",
      "common_excess_risks": ["Location", "Contacts", "Background location"]
    },
    "camera": {
      "label": "Camera",
